rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_ +-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    // Validate Product
    function isValidProduct(p) {
      return p.id is string && p.id.size() <= 100
        && p.name is string && p.name.size() <= 100
        && p.price is number && p.price >= 0.0;
    }
    
    // Validate Order
    function isValidOrder(o) {
      return o.id is string && o.id.size() <= 100
        && o.userId is string && o.userId.size() <= 100
        && o.userName is string && o.userName.size() <= 100
        && o.totalPrice is number && o.totalPrice >= 0.0;
    }
    
    // Validate Custom Order
    function isValidCustomOrder(c) {
      return c.id is string && c.id.size() <= 100
        && c.userId is string && c.userId.size() <= 100
        && c.price is number && c.price >= 0.0;
    }
    
    // Validate Review
    function isValidReview(r) {
      return r.id is string && r.id.size() <= 100
        && r.userName is string && r.userName.size() <= 100
        && r.rating is number && r.rating >= 1.0 && r.rating <= 5.0;
    }
    
    // Validate Inquiry
    function isValidInquiry(i) {
      return i.id is string && i.id.size() <= 100
        && i.userName is string && i.userName.size() <= 100;
    }
    
    // Validate Settings
    function isValidSettings(s) {
      return s.keys().hasAll(['aboutBgImage', 'slide2BgImage', 'slide1BgImage', 'customBannerBgImage', 'recruitBgImage']);
    }

    // Validate User Profile
    function isValidUser(u) {
      return u.id is string && u.id.size() <= 100
        && u.email is string && u.email.size() <= 200
        && u.name is string && u.name.size() <= 100
        && (!u.keys().contains('instagramId') || u.instagramId == null || (u.instagramId is string && u.instagramId.size() <= 100))
        && u.role is string && (u.role == 'admin' || u.role == 'customer');
    }

    // Rules for each collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId) && isValidUser(incoming());
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId) && isValidProduct(incoming());
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if true;
    }

    match /custom_orders/{customId} {
      allow read: if true;
      allow create: if isValidId(customId) && isValidCustomOrder(incoming());
      allow update: if isValidId(customId) && isValidCustomOrder(incoming());
      allow delete: if true;
    }

    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow update: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow delete: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow delete: if true;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId) && isValidSettings(incoming());
    }
  }
}
